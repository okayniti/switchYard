{
  "name": "gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Switchyard team MCP gateway: aggregates upstream MCP servers behind one endpoint, plus REST API, chat agent and dashboard",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "bcryptjs": "3.0.2",
    "express": "5.3.0",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
